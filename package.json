{
  "name": "dsh-autofit",
  "version": "0.3.10",
  "description": "DSH (DeepSeek Harness) plugin autofit: trial-install any plugin in a throwaway profile, auto-repair incompatible ones, install only what passes. Companion of DSH Plugin Radar.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin-compatibility",
    "autofix",
    "dsh-radar"
  ],
  "author": "AdamPlatin123",
  "license": "MIT",
  "homepage": "https://github.com/AdamPlatin123/dsh-autofit#readme",
  "bugs": {
    "url": "https://github.com/AdamPlatin123/dsh-autofit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamPlatin123/dsh-autofit.git"
  },
  "type": "module",
  "bin": {
    "dsh-autofit": "bin/dsh-autofit.js"
  },
  "exports": {
    ".": "./bundle/index.js",
    "./client": "./bundle/client.js",
    "./probe": "./lib/probe/index.js",
    "./describe": "./lib/describe.js",
    "./radar": "./lib/radar.js",
    "./locale/*.json": "./bundle/locale/*.json",
    "./icon": "./bundle/icon.svg",
    "./autofix": "./lib/autofix/index.js"
  },
  "files": [
    "bin/",
    "lib/",
    "bundle/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
